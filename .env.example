COMPOSE_PROJECT_NAME=osl-1 # Change this to your project name
MW_IMAGE_TAG=main # Docker image tag (default: main)
MW_HOST_PORT=8081
MW_SITE_SERVER=http://localhost:8081
MW_SITE_NAME=Wiki
MW_SITE_LANG=en
MW_TIME_ZONE=Europe/Berlin
MW_ADMIN_PASS=change_me123
MW_DB_PASS=change_me123
MW_PAGE_PACKAGES="
world.opensemantic.core
"
MW_AUTOIMPORT_PAGES=true
MW_AUTOBUILD_SITEMAP=false

MYSQL_HOST_PORT=3307
MYSQL_ROOT_PASSWORD=change_me123

DRAWIO_HOST_PORT=8082
DRAWIO_SERVER=http://localhost:8082

GRAPHDB_HOST_PORT=9999

########################### Tuning ###########################
# The defaults below are what the stack runs without them, so leaving these
# unset changes nothing. Raise one at a time and compare with
# ./docs/performance/stack-mem.sh, which reports the symptom for each.

# Triplestore heap. Raise the max when the old generation stays high after a
# full collection. Not needed at all if the SPARQL store is disabled.
#MW_GRAPHDB_HEAP=4g
#MW_GRAPHDB_HEAP_MIN=2g

# Search backend heap. One value feeds both bounds, which Elasticsearch wants
# equal. Raise if the SMW ElasticStore indexes here as well as CirrusSearch.
#MW_ES_HEAP=2g

# Object cache, megabytes as a bare number. Holds sessions, parser cache and
# message cache together. Evictions, not bytes used, are the signal.
#MW_MEMCACHED_MEMORY_MB=512

# Database. Check the buffer pool hit rate rather than comparing the pool
# against the data size: a smaller pool is fine while the working set fits.
#MW_DB_BUFFER_POOL=2G
#MW_DB_MAX_CONNECTIONS=300

# Apache workers. Raise only when the workers in use approach the ceiling; a
# saturated pool queues requests and reads as slowness. This multiplied by
# PHP_MEMORY_LIMIT is the worst case this container can ask for.
#MW_APACHE_MAX_WORKERS=300

# php limits for web requests. These land in conf.d, which is read after the
# main php.ini, so they win over the lower values that ships with.
#PHP_MEMORY_LIMIT=2048M
#PHP_MAX_EXECUTION_TIME=300
#PHP_UPLOAD_MAX_FILESIZE=2048M
