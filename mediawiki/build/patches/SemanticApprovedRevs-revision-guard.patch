 	 */
 	public function doChangeRevisionID( Title $title, &$revisionID ) {
 		if ( ( $approvedRevID = $this->approvedRevsFacade->getApprovedRevID( $title ) ) !== null ) {
-			$revisionID = $approvedRevID;
+			// Cast: the id arrives as the raw database field, a string, and
+			// RevisionGuard::getLatestRevID discards anything that is not an int.
+			$revisionID = (int)$approvedRevID;
 		}
 	}
 
